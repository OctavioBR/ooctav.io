---
import { getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import ProjectList from '../components/ProjectList.astro'
import { sortedProjects } from '../lib/markdown'

const home = await getEntry('pages', 'home')
if (!home) throw new Error('Missing src/content/pages/home.md')
const { Content } = await render(home)
const projects = await sortedProjects()
---

<Base description={home.data.description} markdownPath="/index.md">
  <h1>{home.data.title}</h1>
  <section class="prose"><Content /></section>

  <section class="section">
    <p class="label">Projects:</p>
    <ProjectList projects={projects} />
  </section>
</Base>

<style>
  .section { margin-top: 2.5rem; }
</style>
