---
// Fixed top bar for the resume: name and headline, a mini avatar that fades
// in once the hero photo scrolls away, and icon links (PDF, email, LinkedIn,
// GitHub). Hidden in print.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { LINKS, SITE } from '../site'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  headline: string
  photo: ImageMetadata
}
const { headline, photo } = Astro.props
const link = (label: string) => LINKS.find((l) => l.label === label)?.href
---

<header class="bar">
  <a class="skip" href="#main">Skip to content</a>
  <a class="who" href="/" aria-label={`${SITE.name}, ${headline}: back to home`}>
    <span class="back" aria-hidden="true">&lt;</span>
    <span class="name">{SITE.name}</span>
    <span class="sep" aria-hidden="true">•</span>
    <span class="headline">{headline}</span>
  </a>
  <a class="mini" href="#top" aria-label="Back to top" tabindex="-1">
    <Image src={photo} alt="" width={28} height={28} densities={[1, 2]} position="left" loading="eager" />
  </a>
  <nav class="actions" aria-label="Resume links">
    <a href="/resume.pdf" download="Octavio-Richter-Resume.pdf" title="Download PDF" aria-label="Download resume as PDF">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
    </a>
    <a href={link('Email')} title="Email" aria-label="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
    </a>
    <a href={link('LinkedIn')} title="LinkedIn" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
    </a>
    <a href={link('GitHub')} title="GitHub" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
    </a>
    <ThemeToggle />
  </nav>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: calc(env(safe-area-inset-top, 0px) + 0.5rem) 1rem 0.5rem;
    background: rgb(var(--color-bg-body) / 0.85);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
  }
  .who { justify-self: start; display: flex; gap: 0.6rem; min-width: 0; color: inherit; text-decoration: none; white-space: nowrap; }
  .back { color: rgb(var(--color-text-muted)); transition: transform 0.15s; }
  .who:hover .back, .who:focus-visible .back { color: inherit; transform: translateX(-2px); }
  .headline { color: rgb(var(--color-text-muted)); overflow: hidden; text-overflow: ellipsis; }
  .sep { color: rgb(var(--color-text-muted)); }
  .mini { display: block; line-height: 0; }
  .mini img { width: 28px; height: 28px; object-fit: cover; border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
  .actions { justify-self: end; display: flex; gap: 0.25rem; }
  .actions a { display: grid; place-items: center; width: 2rem; height: 2rem; color: inherit; border-radius: 0.25rem; }
  .actions a:hover, .actions a:focus-visible { opacity: 1; background: rgb(var(--color-bg-code)); }
  svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Fade the mini avatar in as the hero photo scrolls under the bar (no JS).
     The --hero view timeline is set on the photo by the resume page. */
  @supports (timeline-scope: --hero) {
    .mini { animation: reveal linear both; animation-timeline: --hero; animation-range: exit 60% exit 100%; }
    @keyframes reveal { from { opacity: 0; transform: scale(0.6); pointer-events: none; } to { opacity: 1; transform: none; } }
  }

  @media (max-width: 520px) {
    .headline, .sep { display: none; }
  }

  .skip { position: absolute; left: 50%; top: -100rem; transform: translateX(-50%); padding: 0.5rem 2rem; background: #fff; color: #000; }
  .skip:focus { top: 0.5rem; }
</style>
