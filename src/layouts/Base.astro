---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../site'

interface Props {
  title?: string
  description?: string
  /** Path of this page's Markdown twin, such as "/resume.md". */
  markdownPath?: string
  /** Social preview card. Defaults to the generated /og.png; pass null for none. */
  image?: { url: string; alt: string; width: number; height: number; type?: string } | null
}

const { title, description = SITE.description, markdownPath } = Astro.props
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name
const canonical = new URL(Astro.url.pathname, Astro.site)
const defaultImage = {
  url: '/og.png',
  alt: `${SITE.name}: ${SITE.description}`,
  width: 1200,
  height: 630,
  type: 'image/png',
}
const image = Astro.props.image === undefined ? defaultImage : Astro.props.image
const imageUrl = image && new URL(image.url, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Restore the theme pinned by ThemeToggle before first paint. */}
    <script is:inline>try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1e1e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {image && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content={image.type ?? 'image/png'} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={image.alt} />
      </>
    )}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown version" />}
    {/* Cloudflare Web Analytics (ADR-0002). The token is public. Only production gets the beacon. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "e2854eb4bb5e44cc9c6977ee8571215b"}'
      ></script>
    )}
  </head>
  <body>
    {Astro.slots.has('header') ? <slot name="header" /> : <Header />}
    <main id="main">
      <slot />
    </main>
    <Footer markdownPath={markdownPath} />
  </body>
</html>
