---
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.png'
import { NAV } from '../site'
import ThemeToggle from './ThemeToggle.astro'
const path = Astro.url.pathname
---

<header>
  <a class="skip" href="#main">Skip to content</a>
  <div class="row">
    <a href="/" class="home" aria-label="Home">
      <Image src={avatar} alt="" width={80} height={80} densities={[1, 1.5]} loading="eager" />
    </a>
    <nav aria-label="Main navigation">
      {NAV.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header { padding-block: 1.5rem; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .home { display: block; flex-shrink: 0; }
  .home img { display: block; image-rendering: pixelated; }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem 1.25rem; text-transform: uppercase; }
  nav a { color: inherit; text-decoration: none; padding-block: 0.5rem; }
  nav a:hover, nav a:focus-visible, nav a[aria-current='page'] {
    opacity: 1; font-weight: 700; text-decoration: underline; text-underline-offset: 0.2em;
  }
  .skip { position: absolute; left: 50%; top: -100rem; transform: translateX(-50%); padding: 0.5rem 2rem; background: #fff; color: #000; }
  .skip:focus { top: 0.5rem; }
</style>
