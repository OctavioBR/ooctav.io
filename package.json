{
  "name": "ooctav.io",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-pdf.mjs",
    "preview": "npm run build && wrangler dev",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "deploy": "npm run build && wrangler deploy",
    "clean": "node -e \"for (const d of ['dist', '.astro', '.wrangler', 'node_modules']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@fontsource/geist-mono": "^5.3.0",
    "exifr": "^7.1.3",
    "lighthouse": "^13.6.0",
    "satori": "^0.63.2",
    "simple-icons": "16.36.0",
    "typescript": "^7.1.0-beta",
    "wrangler": "^4.158.0"
  }
}
