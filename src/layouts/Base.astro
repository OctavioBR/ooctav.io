---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../site'

interface Props {
  title?: string
  description?: string
  /** Path of this page's Markdown twin, such as "/resume.md". */
  markdownPath?: string
}

const { title, description = SITE.description, markdownPath } = Astro.props
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1e1e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown version" />}
    {/* Cloudflare Web Analytics (ADR-0002). The token is public. Only production gets the beacon. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "e2854eb4bb5e44cc9c6977ee8571215b"}'
      ></script>
    )}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer markdownPath={markdownPath} />
  </body>
</html>
